<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ============ EXTERNAL STORAGE ROOTS ============ -->

    <!-- /storage/emulated/0  (primary external storage) -->
    <external-path
        name="ext_root"
        path="." />

    <!-- /storage/emulated/0/Android/data/<pkg>/files -->
    <external-files-path
        name="ext_files"
        path="." />

    <!-- /storage/emulated/0/Android/data/<pkg>/cache -->
    <external-cache-path
        name="ext_cache"
        path="." />

    <!-- /storage/emulated/0/Android/media/<pkg> -->
    <external-media-path
        name="ext_media"
        path="." />

    <!-- ============ INTERNAL APP STORAGE ============ -->

    <!-- /data/data/<pkg>/files -->
    <files-path
        name="int_files"
        path="." />

    <!-- /data/data/<pkg>/cache -->
    <cache-path
        name="int_cache"
        path="." />

    <!-- ============ SYSTEM ROOT (SD CARDS, /mnt, ETC) ============ -->

    <!-- Covers /storage/XXXX-XXXX (SD cards), /mnt/, /data/local/tmp, etc. -->
    <root-path
        name="root"
        path="/" />

        <files-path name="clipboard_files" path="clipboard/" />


        <!-- existing entries -->
        <external-path name="external" path="." />
        <root-path name="root" path="/storage/8B2E-101F/apks" />

        <!-- NEW: private files (internal app storage) -->
        <files-path name="private_files" path="private/" />


</paths>